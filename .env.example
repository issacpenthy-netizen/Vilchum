# Copy to .env and fill in. Never commit .env.

# Shared secret the VilChum web server sends as X-API-Key. At least 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Put the same value in the web app's ESTIMATOR_API_KEY.
API_KEY=

# Browser origins allowed by CORS, comma-separated, exact, https. Leave EMPTY when only the
# VilChum server calls this service (recommended: browsers then cannot call it at all).
# Wildcards ("*") are refused at startup.
ALLOWED_ORIGINS=
# Optional regex for preview deployments, e.g. ^https://vilchum-git-[a-z0-9-]+-yourteam\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# Model and thresholds
MODEL_PATH=model/best.pt
# Detections below this are discarded.
DETECTION_FLOOR=0.25
# Any accepted item below this makes the result "low_confidence".
LOW_CONFIDENCE_THRESHOLD=0.50
IOU_THRESHOLD=0.5
# Photos with a sharpness score below this are "low_confidence" (reason "blurry"): the model
# invents confident cans on blurry photos. Each response's meta.blur_score helps tune it.
# Sharp sample photos (incl. very dark) score 24+; blurry ones where the model went wrong, and
# smooth low-contrast blobs, score 11 or less. 0 disables.
BLUR_THRESHOLD=16
IMAGE_SIZE=640

# Limits
MAX_UPLOAD_BYTES=12582912
MAX_IMAGE_PIXELS=40000000
# Requests allowed to wait for the GPU before new ones get 503 "busy".
MAX_QUEUE=8

# true = refuse to start without CUDA (recommended on the GPU PC once setup works).
REQUIRE_GPU=false
# true = expose /docs and /openapi.json (keep false on the public tunnel).
ENABLE_DOCS=false
LOG_LEVEL=INFO
