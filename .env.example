# Local SQLite database file used by Prisma.
DATABASE_URL="file:./dev.db"
# HMAC signing secret for the httpOnly session cookie. Required; there is no built-in fallback.
# Generate with: openssl rand -hex 32  (production refuses placeholders and values under 32 characters)
SESSION_SECRET="replace-with-a-long-random-value"
# Google OAuth web client credentials. Add http://localhost:3000/api/auth/google/callback
# as an authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Gemini API key for live photo verification. Empty uses a labelled local MOCK verifier in development only.
GEMINI_API_KEY=""
# Optional Gemini model override. Defaults to gemini-3.8-flash.
GEMINI_MODEL="gemini-3.8-flash"
# Enable fixed 123456 OTP for local demos. Development only: production refuses to start with this set.
DEV_OTP="true"
# Password for /admin. Production refuses defaults and values under 16 characters.
ADMIN_PASSWORD="change-me"
